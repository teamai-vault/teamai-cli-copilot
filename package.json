{
  "name": "teamai-cli-copilot",
  "version": "0.5.0",
  "type": "module",
  "files": [
    "dist",
    "agents/teamai-recall.agent.md",
    "skills/teamai",
    "README.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "teamai": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build && node scripts/check-package-bytes.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run test/unit --no-file-parallelism",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:e2e:copilot": "node scripts/smoke-teamai.mjs",
    "test:e2e:fallback": "node scripts/smoke-fallback.mjs",
    "package:test": "node test/helpers/verify-builtin-package.mjs",
    "rename:marketplace": "node scripts/rename-marketplace.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
